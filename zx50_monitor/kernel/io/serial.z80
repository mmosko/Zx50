; =============================================================================
; Zx50 Serial Kernel Driver
; Integrates standard symbolic equates from sio_reg_defs.z80
; =============================================================================

    INCLUDE "sio_reg_defs.z80"

Init_SIO:
    ; --- 0. Initialize Ring Buffers ---
    LD IX, PORT_A_TX_RB
    CALL RB_Init
    LD IX, PORT_A_RX_RB 
    CALL RB_Init

    ; =========================================================================
    ; 1. Configure SIO/DART Channel A (Console Port)
    ; =========================================================================
    LD C, SIO_A_CMD

    ; --- Reset Channel A ---
    LD A, SIO_CMD_CH_RESET  ; WR0: Reset Channel Command
    OUT (C), A

    ; --- WR4: Clock Mode, Stop Bits, Parity ---
    LD A, SIO_WR0_REG4      ; Select SIO WR4 (0x04)
    OUT (C), A
    LD A, SIO_WR4_CLK_X16 | SIO_WR4_STOP_1 | SIO_WR4_PAR_NONE
    OUT (C), A

    ; --- WR3: Receiver Parameters ---
    LD A, SIO_WR0_REG3      ; Select SIO WR3 (0x03)
    OUT (C), A
    LD A, SIO_WR3_RX_8 | SIO_WR3_AUTO_EN | SIO_WR3_RX_EN
    OUT (C), A

    ; --- WR5: Transmitter Parameters ---
    LD A, SIO_WR0_REG5      ; Select SIO WR5 (0x05)
    OUT (C), A
    LD A, SIO_WR5_TX_8 | SIO_WR5_TX_EN | SIO_WR5_RTS_EN
    OUT (C), A

    ; --- WR1: Interrupt Configuration ---
    LD A, SIO_WR0_REG1      ; Select SIO WR1 (0x01)
    OUT (C), A
    LD A, SIO_WR1_RX_ALL_PAR | SIO_WR1_TX_INT_EN
    OUT (C), A

    ; =========================================================================
    ; 2. Configure SIO/DART Channel B (Auxiliary / Program Port)
    ; =========================================================================
    LD C, SIO_B_CMD

    ; --- Reset Channel B ---
    LD A, SIO_CMD_CH_RESET  ; WR0: Reset Channel Command
    OUT (C), A

    ; --- WR2: Interrupt Vector Register (Shared Base written directly to Channel B) ---
    LD A, SIO_WR0_REG2      ; Select SIO WR2 (0x02)
    OUT (C), A
    LD A, 0x10              ; SIO Vector Base = 0x10 (Maps cleanly to aligned IVT offsets)
    OUT (C), A

    ; --- WR4: Clock Mode, Stop Bits, Parity ---
    LD A, SIO_WR0_REG4      ; Select SIO WR4 (0x04)
    OUT (C), A
    LD A, SIO_WR4_CLK_X16 | SIO_WR4_STOP_1 | SIO_WR4_PAR_NONE
    OUT (C), A

    ; --- WR3: Receiver Parameters ---
    LD A, SIO_WR0_REG3      ; Select SIO WR3 (0x03)
    OUT (C), A
    LD A, SIO_WR3_RX_8 | SIO_WR3_AUTO_EN | SIO_WR3_RX_EN
    OUT (C), A

    ; --- WR5: Transmitter Parameters ---
    LD A, SIO_WR0_REG5      ; Select SIO WR5 (0x05)
    OUT (C), A
    LD A, SIO_WR5_TX_8 | SIO_WR5_TX_EN | SIO_WR5_RTS_EN
    OUT (C), A

    ; --- WR1: Interrupt Configuration (Status Affects Vector) ---
    LD A, SIO_WR0_REG1      ; Select SIO WR1 (0x01)
    OUT (C), A
    LD A, SIO_WR1_RX_ALL_PAR | SIO_WR1_TX_INT_EN | SIO_WR1_STATUS_EN
    OUT (C), A
    
    ; =========================================================================
    ; 3. Establish Default Shadows and Apply Initial Interrupt States
    ; =========================================================================
    LD A, 0                 ; Select CHAR Mode (0)
    LD C, SIO_A_CMD
    CALL SetTermMode_Inner  ; Commit cleanly to SIO_A_WR1_STATE without corrupting maps

    LD A, 0                 ; Select CHAR Mode (0)
    LD C, SIO_B_CMD
    CALL SetTermMode_Inner  ; Commit cleanly to SIO_B_WR1_STATE

    ; --- Update LCD status message ---
    LD HL, MSG_SIO_READY    
    CALL PrintStringLCD    

    RET
    

; =============================================================================
; Subroutine: Console_Tx (THE PRODUCER)
; Purpose:    Place a character on the transmit ring buffer. 
;             "Primes the pump" if the SIO hardware is currently idle.
; =============================================================================
Console_Tx:
    PUSH IX
    PUSH BC
    
.retry:
    DI                      ; 1. Disable ints to avoid race condition
    LD IX, PORT_A_TX_RB
    CALL RB_Write
    JR NC, .success
    
    ; BUFFER IS FULL! 
    ; Turn on Tx Interrupts so the hardware drains it, then sleep.
    LD A, (SIO_A_WR1_STATE)
    OR SIO_WR1_TX_INT_EN
    LD (SIO_A_WR1_STATE), A 
    
    LD C, CONSOLE_CMD
    LD B, A                 
    LD A, SIO_WR0_REG1      ; Select SIO WR1
    OUT (C), A
    LD A, B
    OUT (C), A
    
    EI
    HALT                    ; Sleep until the SIO ISR drains a byte
    JR .retry               ; Wake up and try writing again
    
.success:
    ; Byte in ring buffer.
    ; Is the SIO hardware idle?
    IN A, (CONSOLE_CMD)     ; Read SIO RR0
    BIT 2, A                ; Bit 2 is Tx Buffer Empty
    JR Z, .enable_ints      ; If 0, it's busy. Interrupt will fire naturally!
    
    ; SIO IS IDLE! ("Prime the Pump")
    ; We must manually move one byte to the hardware to trigger the edge.
    CALL RB_Read            ; Pop the oldest byte (guaranteed to exist)
    OUT (CONSOLE_DAT), A    ; Blast it to the hardware!
    
.enable_ints:
    ; 5. Ensure Tx Interrupts are enabled for the remaining bytes
    LD A, (SIO_A_WR1_STATE)
    OR SIO_WR1_TX_INT_EN
    LD (SIO_A_WR1_STATE), A 
    
    LD C, CONSOLE_CMD
    LD B, A                 
    LD A, SIO_WR0_REG1      ; Select SIO WR1
    OUT (C), A
    LD A, B
    OUT (C), A
    
    EI                      ; 6. Safe to re-enable interrupts
    POP BC
    POP IX
    RET

; =============================================================================
; SIO Port A Tx Empty ISR (THE CONSUMER)
; =============================================================================
SIO_A_Tx_ISR:
    EX AF, AF'
    EXX
    PUSH IX

    LD IX, PORT_A_TX_RB
    CALL RB_Read
    JR C, .buffer_empty
    
    OUT (CONSOLE_DAT), A
    JR .exit
    
.buffer_empty:
    ; Buffer is dry. Disable Tx Ints safely.
    LD A, (SIO_A_WR1_STATE)
    AND 255 - SIO_WR1_TX_INT_EN ; Mask out the Tx Int Enable bit (Compiler safe)
    LD (SIO_A_WR1_STATE), A
    
    LD C, CONSOLE_CMD
    LD B, A                 
    LD A, SIO_WR0_REG1      ; Select SIO WR1
    OUT (C), A
    LD A, B
    OUT (C), A

.exit:
    POP IX
    EXX
    EX AF, AF'
    EI
    RETI

; =============================================================================
; SIO Port A Rx Character Available ISR (THE PRODUCER)
; =============================================================================
SIO_A_Rx_ISR:
    EX AF, AF'
    EXX
    PUSH IX

    ; Read the character from the hardware
    IN A, (CONSOLE_DAT)
    
    ; [Future Cooked Mode: CP 0x03 -> Trap Ctrl+C here!]
    
    ; Push it into the Rx Ring Buffer
    LD IX, PORT_A_RX_RB
    CALL RB_Write

    ; (If Carry is SET, the buffer was full and the byte is dropped. 
    ;  In a real UART we might send an XOFF, but dropping is fine for now).

    POP IX
    EXX
    EX AF, AF'
    EI
    RETI

; =============================================================================
; SIO Port B Tx Empty ISR (Shared Debug Transmit ISR)
; =============================================================================
SIO_B_Tx_ISR:
    EX AF, AF'
    EXX

    ; --- REQUIRED: Reset Tx Interrupt Pending in SIO WR0 ---
    LD A, SIO_CMD_RST_TX_INT ; Command 0x28: Reset Tx Int Pending
    OUT (SIO_B_CMD), A

    ; (Placeholder/Diagnostic: If adding a Port B transmit ring buffer in the future,
    ;  you can pop the character and OUT it to DEBUG_DAT here.)

    EXX
    EX AF, AF'
    EI
    RETI

; =============================================================================
; SIO Port B Rx Character Available ISR (Shared Debug Receive ISR)
; =============================================================================
SIO_B_Rx_ISR:
    EX AF, AF'
    EXX

    ; Read character from hardware to auto-clear the Rx interrupt state
    IN A, (DEBUG_DAT)

    ; (Placeholder: Process or push incoming byte to Port B receive queue here.)

    EXX
    EX AF, AF'
    EI
    RETI

; =============================================================================
; Subroutine: Console_Rx (THE CONSUMER)
; Purpose:    Waits for and receives a single character from the Rx Ring Buffer
; Output:     A = Received character
; Destroys:   A, IX
; =============================================================================
Console_Rx:
    LD IX, PORT_A_RX_RB
    CALL RB_Blocking_Read
    RET

; =============================================================================
; Subroutine: Console_Poll (THE CONSUMER)
; Purpose:    Checks if a character is available without blocking.
; Output:     Carry Flag (C) = SET if no data.
;             Carry Flag (C) = RESET (Clear) if data received, byte in A.
; Destroys:   A, IX
; =============================================================================
Console_Poll:
    LD IX, PORT_A_RX_RB
    CALL RB_Read
    RET

; =============================================================================
; Subroutine: Debug_Tx
; Purpose:    Transmits a single character out of the debug trace port
; Input:      A = Character to transmit
; Destroys:   None (Flags are preserved)
; =============================================================================
Debug_Tx:
    PUSH AF                 
.tx_wait:
    IN A, (DEBUG_CMD)       ; Poll SIO Port B
    BIT 2, A                
    JR Z, .tx_wait          
    
    POP AF                  
    OUT (DEBUG_DAT), A      ; Blast to SIO Port B
    RET

; =============================================================================
; Subroutine: SetTermMode (Syscall 0x001D)
; Purpose:    Dynamically changes the SIO mode.
; Input:      C = SIO Command Port (SIO_A_CMD or SIO_B_CMD)
;             A = Terminal Mode (0 = CHAR mode, 1 = Bulk mode)
; =============================================================================
SetTermMode:
    DI                          ; Prevent ISRs from hijacking the SIO pointer
    CALL SetTermMode_Inner      ; Handle the mapping and hardware write
    EI                          ; Safe to re-enable interrupts
    RET

SetTermMode_Inner:
    ; --- Same as SetTermMode, but does NOT toggle DI/EI ---
    PUSH BC
    PUSH AF
    
    ; 1. Determine if we are configuring Channel A or Channel B
    LD A, C
    CP SIO_B_CMD
    JR Z, .channel_b
    
    ; --- Channel A Mode Mapping ---
    POP AF                      ; Retrieve mode selection (0 or 1)
    OR A                        ; Is it 0 (CHAR)?
    JR NZ, .ch_a_bulk
    
    ; Channel A - CHAR Mode
    LD A, SIO_WR1_RX_ALL_PAR | SIO_WR1_TX_INT_EN
    JR .apply_mode
    
.ch_a_bulk:
    ; Use RX_ALL_PAR instead of RX_FIRST so the ring buffer doesn't freeze
    ; Had been set to RX_FIRST, but that caused the ring buffer to freeze if a byte was dropped.
    LD A, SIO_WR1_RX_ALL_PAR | SIO_WR1_TX_INT_EN
    JR .apply_mode

.channel_b:
    ; --- Channel B Mode Mapping ---
    POP AF                      ; Retrieve mode selection (0 or 1)
    OR A                        ; Is it 0 (CHAR)?
    JR NZ, .ch_b_bulk
    
    ; Channel B - CHAR Mode
    LD A, SIO_WR1_RX_ALL_PAR | SIO_WR1_TX_INT_EN | SIO_WR1_STATUS_EN
    JR .apply_mode
    
.ch_b_bulk:
    ; Channel B - Bulk Mode
    LD A, SIO_WR1_RX_FIRST | SIO_WR1_TX_INT_EN | SIO_WR1_STATUS_EN

.apply_mode:
    CALL UpdateShadowRegister   ; Save to correct shadow RAM (A is the SIO WR1 byte)
    PUSH AF                     
    LD A, SIO_WR0_REG1          ; Select SIO Write Register 1 (0x01)
    OUT (C), A
    POP AF                  
    OUT (C), A                  ; Push configuration to hardware
    
    POP BC
    RET

; --- Internal Helper: Maps Port Address to Correct Shadow Variable ---
UpdateShadowRegister:
    PUSH AF
    LD A, C
    CP SIO_B_CMD                
    JR Z, .route_port_b
    POP AF
    LD (SIO_A_WR1_STATE), A     ; Commit to Port A Storage
    RET
.route_port_b:
    POP AF
    LD (SIO_B_WR1_STATE), A     ; Commit to Port B Storage
    RET

; =============================================================================
; Serial RAM Storage
; =============================================================================
SIO_A_WR1_STATE:    BLOCK 1     ; 1 byte shadow tracking for Port A WR1
SIO_B_WR1_STATE:    BLOCK 1     ; 1 byte shadow tracking for Port B WR1
    
PORT_A_TX_RB RingBuffer {}      ; Dynamically sized Tx Buffer

PORT_A_RX_RB RingBuffer {}      ; Dynamically sized Rx Buffer (for later)