
Init_CTC:
    ; 1. Configure CTC Channel 0 for SIO Port A
    LD A, 0x07              ; Control Word: Interrupts Off, Timer Mode, Prescaler 16, TC Follows, Reset
    OUT (CTC_CH0), A
    LD A, 0x01              ; Time Constant = 1
    OUT (CTC_CH0), A

    ; 2. Configure CTC Channel 1 for SIO Port B
    LD A, 0x07              ; Same configuration for Port B
    OUT (CTC_CH1), A
    LD A, 0x01
    OUT (CTC_CH1), A
    
    ; --- Tell the CTC where its vectors start ---
    LD A, 0x00          ; Vector Base: 0x00 
    OUT (CTC_CH0), A    ; Writing a vector to CH0 sets it for the whole chip
    
    ; --- Start Channel 3 (100Hz Tick) ---
    ; Control Word: Int Enable (1), Timer (0), Prescale 256 (1), 
    ; Edge (0), TC Follows (1), Reset (1), Control (1)
    LD A, 0xA7          
    OUT (CTC_CH3), A
    
    LD A, 195           ; Time Constant: 5,000,000 / 256 / 195 = ~100.16Hz
    OUT (CTC_CH3), A

    RET

Init_SIO:
    ; 1. Initialize SIO Port A (FTDI)
    LD C, SIO_A_CMD         ; Point C register to SIO Port A Command
    
    LD A, 0x18              ; WR0: Channel Reset
    OUT (C), A
    
    LD A, 0x04              ; WR0: Select WR4
    OUT (C), A
    LD A, 0x44              ; WR4: 16x Clock, 1 Stop Bit, No Parity
    OUT (C), A
    
    LD A, 0x01              ; WR0: Select WR1
    OUT (C), A
    LD A, 0x00              ; WR1: Interrupts Disabled (Polled Mode)
    OUT (C), A
    
    LD A, 0x03              ; WR0: Select WR3
    OUT (C), A
    LD A, 0xC1              ; WR3: Receive 8 Bits/Char, Receiver Enable
    OUT (C), A
    
    LD A, 0x05              ; WR0: Select WR5
    OUT (C), A
    LD A, 0xEA              ; WR5: Transmit 8 Bits/Char, Transmitter Enable, DTR/RTS High
    OUT (C), A

    ; 2. Initialize SIO Port B (MAX232/DB9)
    LD C, SIO_B_CMD         ; Point C register to SIO Port B Command
    
    LD A, 0x18              ; WR0: Channel Reset
    OUT (C), A
    
    LD A, 0x04              ; WR0: Select WR4
    OUT (C), A
    LD A, 0x44              ; WR4: 16x Clock, 1 Stop Bit, No Parity
    OUT (C), A
    
    LD A, 0x01              ; WR0: Select WR1
    OUT (C), A
    LD A, 0x00              ; WR1: Interrupts Disabled (Polled Mode)
    OUT (C), A
    
    LD A, 0x03              ; WR0: Select WR3
    OUT (C), A
    LD A, 0xC1              ; WR3: Receive 8 Bits/Char, Receiver Enable
    OUT (C), A
    
    LD A, 0x05              ; WR0: Select WR5
    OUT (C), A
    LD A, 0xEA              ; WR5: Transmit 8 Bits/Char, Transmitter Enable, DTR/RTS High
    OUT (C), A

    LD HL, MSG_SIO_READY    ; Point HL to the SIO string
    CALL PrintStringLCD     ; Blast it to the LCD
    RET

; =============================================================================
; Subroutine: PrintConsoleString
; Purpose:    Prints a null-terminated string to the main console port
; Input:      HL = Pointer to the null-terminated string
; Destroys:   A, HL
; =============================================================================
PrintConsoleString:
    LD A, (HL)              ; Load the next character
    OR A                    ; Logical OR with itself (Sets Zero flag if A=0x00)
    RET Z                   ; If it's the null terminator, return
    
    CALL Console_Tx        ; Print the character
    INC HL                  ; Move to the next character
    JR PrintConsoleString    ; Loop

; =============================================================================
; Subroutine: Console_Tx
; Purpose:    Transmits a single character out of the main console port
; Input:      A = Character to transmit
; Destroys:   None (Flags are preserved)
; =============================================================================
Console_Tx:
    PUSH AF                 ; Save the character we want to send
.tx_wait:
    IN A, (CONSOLE_CMD)       ; Read SIO RR0
    BIT 2, A                ; Is Bit 2 (Tx Buffer Empty) set?
    JR Z, .tx_wait          ; If not, loop and wait
    
    POP AF                  ; Restore the character
    OUT (CONSOLE_DAT), A      ; Blast it out the serial port
    RET

; =============================================================================
; Subroutine: Console_Rx
; Purpose:    Waits for and receives a single character from Console port
; Output:     A = Received character
; Destroys:   A
; =============================================================================
Console_Rx:
    IN A, (CONSOLE_CMD)     ; Read SIO RR0
    BIT 0, A                ; Is Bit 0 (Rx Character Available) set?
    JR Z, Console_Rx        ; If not, loop and wait
    
    IN A, (CONSOLE_DAT)       ; Read the character from the buffer
    RET

; =============================================================================
; Subroutine: Console_Poll
; Purpose:    Checks if a character is available. Does not block.
; Output:     Carry Flag (C) = SET if no data.
;             Carry Flag (C) = RESET (Clear) if data received, byte in A.
; =============================================================================
Console_Poll:
    IN A, (CONSOLE_CMD)
    BIT 0, A
    JR Z, .no_char          ; If bit 0 is empty, jump to exit
    
    IN A, (CONSOLE_DAT)     ; Read the byte!
    OR A                    ; Clear the Carry Flag to indicate success
    RET

.no_char:
    SCF                     ; Set the Carry Flag to indicate no data
    RET
    
; =============================================================================
; Subroutine: PrintDebugString
; Purpose:    Prints a null-terminated string to the debug trace port
; Input:      HL = Pointer to the null-terminated string
; Destroys:   A, HL
; =============================================================================
PrintDebugString:
    LD A, (HL)              
    OR A                    
    RET Z                   
    
    CALL Debug_Tx           ; Call the debug specific Tx routine
    INC HL                  
    JR PrintDebugString    

; =============================================================================
; Subroutine: Debug_Tx
; Purpose:    Transmits a single character out of the debug trace port
; Input:      A = Character to transmit
; Destroys:   None (Flags are preserved)
; =============================================================================
Debug_Tx:
    PUSH AF                 
.tx_wait:
    IN A, (DEBUG_CMD)       ; Poll SIO Port B
    BIT 2, A                
    JR Z, .tx_wait          
    
    POP AF                  
    OUT (DEBUG_DAT), A      ; Blast to SIO Port B
    RET

; =============================================================================
; Subroutine: PrintStringLCD
; Purpose:    Blasts a length-prefixed string to the Front Panel LCD.
; Input:      HL = Pointer to the length-prefixed string in ROM
; Destroys:   A, B, C, HL
; =============================================================================
PrintStringLCD:
    LD B, (HL)          ; 1. Load the string length into B (OTIR loop counter)
    INC HL              ; 2. Advance HL to point to the 0x01 command byte
    LD C, LCD_PORT      ; 3. C = 0x50 (Pico Front Panel I/O Port)
    OTIR                ; 4. Output (HL) to Port (C), HL++, B--, repeat until B=0
    RET                 ; 5. Return to caller

; =============================================================================
; Subroutine: DumpLine
; Purpose:    Prints a 16-byte hex and ASCII dump of memory, advances HL by 16
; Input:      HL = Starting address
; Destroys:   A, B, C
; =============================================================================
DumpLine:
    ; 1. Print Address (HL)
    CALL PrintHexWord
    LD A, ' '
    CALL Console_Tx
    CALL Console_Tx

    ; 2. Print 16 Hex Bytes
    PUSH HL             ; Save our start address for the ASCII pass
    LD B, 16            ; Loop counter
.hex_loop:
    LD A, (HL)
    CALL PrintHexByte
    LD A, ' '
    CALL Console_Tx
    INC HL
    DJNZ .hex_loop

    ; 3. Print the gap before ASCII
    LD A, ' '
    CALL Console_Tx

    ; 4. Print 16 ASCII Characters
    POP HL              ; Restore start address
    LD B, 16
.ascii_loop:
    LD A, (HL)
    
    ; Check if A is a printable ASCII character (0x20 to 0x7E)
    CP 0x20
    JR C, .unprintable  ; Less than space?
    CP 0x7F
    JR NC, .unprintable ; DEL (0x7F) or higher?
    JR .print_char
    
.unprintable:
    LD A, '.'           ; Replace with a dot
    
.print_char:
    CALL Console_Tx
    INC HL              ; Advance HL
    DJNZ .ascii_loop

    ; 5. Print Newline
    PUSH HL             ; Save our advanced memory pointer! (PrintConsoleString destroys HL)
    LD HL, MSG_CRLF
    CALL PrintConsoleString
    POP HL              ; Restore memory pointer
    RET
    
; =============================================================================
; Subroutine: PrintNullStringLCD
; Purpose:    Prints a null-terminated string to the Front Panel LCD
; Input:      HL = Pointer to the null-terminated string
; Destroys:   A, C, HL
; =============================================================================
PrintNullStringLCD:
    LD C, LCD_PORT          ; Set C to 0x50 (LCD Port)
.loop:
    LD A, (HL)              ; Load the next character
    OR A                    ; Is it 0x00?
    RET Z                   ; If so, return
    
    OUT (C), A              ; Blast the character to the LCD
    INC HL                  ; Advance pointer
    JR .loop