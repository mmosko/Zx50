        <mxCell id="75" parent="1" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=15;fontColor=#334155;" value="&lt;b&gt;Clock Domains:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;ZCLK (8 MHz - 10 MHz):&lt;/b&gt; Primary Z80 CPU clock.&lt;br&gt;• &lt;b&gt;MCLK (32 MHz - 40 MHz):&lt;/b&gt; 4x Master Clock for synchronous DMA.&lt;br&gt;• &lt;b&gt;FPGA Internal Clock (96 MHz - 160 MHz):&lt;/b&gt; 3x to 4x MCLK for FPU." vertex="1">
          <mxGeometry height="105" width="480" x="80" y="995" as="geometry" />
        </mxCell>
        <mxCell id="76" parent="1" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=15;fontColor=#334155;" value="&lt;b&gt;Backplane Bus Widths &amp;amp; Signals:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;A[15:0]:&lt;/b&gt; 16-bit Z80 Address Bus.&lt;br&gt;• &lt;b&gt;D[7:0]:&lt;/b&gt; 8-bit Bidirectional Z80 Data Bus.&lt;br&gt;• &lt;b&gt;C[14:0]:&lt;/b&gt; 15-bit Z80 Control Bus&amp;nbsp;&lt;br&gt;• &lt;b&gt;GPIO[15:0]:&lt;/b&gt; 16-bit general purpose fast interconnect." vertex="1">
          <mxGeometry height="105" width="360" x="645" y="990" as="geometry" />
        </mxCell>
        <mxCell id="77" parent="1" style="text;html=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=15;fontColor=#334155;" value="&lt;b&gt;Shadow Bus DMA Protocol (SD[8:0], SC[5:0]):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;SD[8:0]:&lt;/b&gt; 9-bit Shadow Data Bus (8-bit data + parity).&lt;br&gt;• &lt;b&gt;SC[5:0]:&lt;/b&gt; Shadow Control.&lt;br&gt;• &lt;b&gt;Transfers:&lt;/b&gt; Direct 40 MHz peer-to-peer burst DMA.&lt;br&gt;• &lt;b&gt;Bus Termination:&lt;/b&gt; All lines AC terminated to eliminate line reflections." vertex="1">
          <mxGeometry height="105" width="455" x="1120" y="982.5" as="geometry" />
        </mxCell>
