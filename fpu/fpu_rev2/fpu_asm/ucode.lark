// =============================================================================
// FPU Microcode Assembly Grammar (ucode.lark)
// Based on Zx50 FPU Rev 2 Low-Level System Design & SystemAssembler.md
// =============================================================================

start: (line | NEWLINE)* [line_eof]

line: [label] [statement] [comment] NEWLINE
line_eof: [label] [statement] [comment]

comment: COMMENT
COMMENT: /;[^\r\n]*/

label: SYMBOL ":"

statement: directive | instruction

// -----------------------------------------------------------------------------
// Directives & Control Macros
// -----------------------------------------------------------------------------

directive: dir_org
         | dir_equ
         | dir_align
         | dir_entry
         | dir_global

dir_org: ".org"i imm_operand
dir_equ: ".equ"i SYMBOL [","] imm_operand
dir_align: ".align"i imm_operand
dir_entry: ".entry"i (SYMBOL | imm_operand)
dir_global: ".global"i SYMBOL

// -----------------------------------------------------------------------------
// Instructions by Block & Family
// -----------------------------------------------------------------------------

instruction: [DELAY_ATTR] inst_body
DELAY_ATTR: ".delay"i

inst_body: inst_arith
         | inst_cmp
         | inst_pack
         | inst_math_alu
         | inst_logic_bin
         | inst_logic_unary
         | inst_shift
         | inst_stack
         | inst_mem
         | inst_ctrl
         | inst_noarg

// Block 0: Adder / Arithmetic Block
inst_arith: ARITH_OP [WIDTH_SUFFIX] reg "," [reg ","] reg_or_imm
ARITH_OP: "ADD"i | "ADC"i | "SUB"i | "SBB"i | "EXP_ADD"i | "EXP_SUB"i

inst_cmp: "CMP"i [WIDTH_SUFFIX] reg "," reg_or_imm

// Block 1: Math / Float / Multiply / Divide
inst_pack: PACK_OP [WIDTH_SUFFIX] reg "," reg
PACK_OP: "PACK"i | "UNPACK"i

inst_math_alu: MATH_ALU_OP [WIDTH_SUFFIX] reg "," [reg ","] reg_or_imm
MATH_ALU_OP: "MULU"i | "DIVU"i | "MUL"i | "DIV"i

// Block 2: Logic Block
inst_logic_bin: LOGIC_BIN_OP [WIDTH_SUFFIX] reg "," [reg ","] reg_or_imm
LOGIC_BIN_OP: "AND"i | "OR"i | "XOR"i

inst_logic_unary: LOGIC_UNARY_OP [WIDTH_SUFFIX] reg
LOGIC_UNARY_OP: "FABS"i | "FCHS"i | "NOT"i

// Block 6: Shifter / LZC Block
inst_shift: SHIFT_OP [WIDTH_SUFFIX] reg ["," reg_or_imm]
SHIFT_OP: "LSL"i | "LSR"i | "ASL"i | "ASR"i | "LZC"i

// Block 4 & 5: Stack, Memory & Status Blocks
inst_stack: "PUSH"i [WIDTH_SUFFIX] reg_or_imm -> inst_push
          | "POP"i [WIDTH_SUFFIX] reg          -> inst_pop

reg_indirect: "[" reg "]"
mem_addr: imm_operand | reg_indirect

inst_mem: "LDC"i [WIDTH_SUFFIX] reg "," table_ref "," reg_or_imm   -> inst_ldc
        | "LDI"i reg "," imm_operand                               -> inst_ldi_reg
        | "LDI"i FLAG "," imm_operand                              -> inst_ldi_flag
        | "LD"i [WIDTH_SUFFIX] reg "," mem_addr                    -> inst_ld
        | "STO"i [WIDTH_SUFFIX] mem_addr "," reg_or_imm            -> inst_sto
        | "LDU"i [WIDTH_SUFFIX] reg "," imm_operand                -> inst_ldu
        | "STU"i [WIDTH_SUFFIX] imm_operand "," reg_or_imm         -> inst_stu
        | "MOV"i [WIDTH_SUFFIX] reg "," reg_or_imm                 -> inst_mov
        | "SWAP"i [WIDTH_SUFFIX] reg "," reg                       -> inst_swap

table_ref: TABLE_NAME | imm_operand
TABLE_NAME: "RECIP"i | "SQRT"i | "TRIG"i | "CHEB"i | "CONST"i

// Block 3: Control Block
inst_ctrl: "JMP"i imm_operand                -> inst_jmp
         | "JNZ"i [FLAG ","] imm_operand     -> inst_jnz
         | "JZ"i [FLAG ","] imm_operand      -> inst_jz
         | "DJNZ"i imm_operand               -> inst_djnz
         | "CALL"i imm_operand               -> inst_call

// Zero-argument instructions across Control & Status
inst_noarg: NOARG_OP
NOARG_OP: "RET"i | "NOP"i | "HALT"i | "SSAV"i | "SRES"i

// -----------------------------------------------------------------------------
// Terminals & Lexer Rules
// -----------------------------------------------------------------------------

FLAG: "DIFF_SIGN"i | "DF"i | "D"i
    | "ERR"i | "EF"i
    | "UNDERFLOW"i | "UF"i | "U"i
    | "OVERFLOW"i | "VF"i | "V"i
    | "CARRY"i | "CF"i
    | "SIGN"i | "SF"i | "S"i
    | "ZERO"i | "ZF"i | "Z"i
    | "BUSY"i | "BF"i | "BSY"i

WIDTH_SUFFIX: ".64" | ".32"

REG_32: "AL"i | "AH"i | "BL"i | "BH"i | "CL"i | "CH"i | "DL"i | "DH"i | "FL"i | "FH"i | "EA"i | "EB"i | "C"i | "IMM"i | "NONE"i | "UPC"i | "SP"i | "OSP"i | "STATUS"i
REG_64: "AX"i | "BX"i | "CX"i | "DX"i | "FX"i
reg: REG_32 | REG_64
reg_or_imm: reg | imm_operand

imm_operand: ["IMM="i | "#"] (HEX_INT | BIN_INT | SIGNED_INT | SYMBOL)
HEX_INT: /0x[0-9a-fA-F]+/
BIN_INT: /0b[01]+/
SIGNED_INT: /-?[0-9]+/

SYMBOL: /\.?[a-zA-Z_][a-zA-Z0-9_]*/

%ignore /#[ \t][^\r\n]*/
%ignore /#[a-zA-Z_][^\r\n]*/
%import common.WS_INLINE
%ignore WS_INLINE
NEWLINE: (/[\r\n]+/)+